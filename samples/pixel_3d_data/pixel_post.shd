// Composite pass: upscale the low-resolution scene and shade its edges.
//
// A port of three.js's RenderPixelatedPass. The important part is the last line: the edge
// indicators MULTIPLY the texel rather than blending toward an ink colour. Depth edges (a
// silhouette against something further away) darken; normal edges (a crease turned toward the
// bias direction) brighten. That asymmetry is what makes the result read as shaded pixel art
// rather than a cartoon outline.
//
// A draw shader, not a two-file shader: the vertex stage is a full-screen quad, so CF's own is
// fine. Bindings start at 1 because CF's fragment stage already occupies binding 0 in both sets.

layout (set = 2, binding = 1) uniform sampler2D scene_tex;
layout (set = 2, binding = 2) uniform sampler2D normal_tex;

layout (set = 3, binding = 1) uniform shd_uniforms {
	vec2 u_texel;                 // 1.0 / low-resolution size
	float u_normal_edge_strength;
	float u_depth_edge_strength;
	float u_view_mode;            // 0 = composite, 1 = normals, 2 = depth
};

// CF gives a canvas one colour target, so the g-buffer packs both: normal in rgb (encoded to
// [0,1], as three.js's normal buffer is) and depth in alpha. three.js keeps them in two separate
// textures, which is why it has both tNormal and tDepth.
float getDepth(vec2 uv, int x, int y)
{
	return texture(normal_tex, uv + vec2(float(x), float(y)) * u_texel).a;
}

vec3 getNormal(vec2 uv, int x, int y)
{
	return texture(normal_tex, uv + vec2(float(x), float(y)) * u_texel).rgb * 2.0 - 1.0;
}

float depthEdgeIndicator(vec2 uv, float depth)
{
	float diff = 0.0;
	diff += clamp(getDepth(uv, 1, 0) - depth, 0.0, 1.0);
	diff += clamp(getDepth(uv, -1, 0) - depth, 0.0, 1.0);
	diff += clamp(getDepth(uv, 0, 1) - depth, 0.0, 1.0);
	diff += clamp(getDepth(uv, 0, -1) - depth, 0.0, 1.0);
	return floor(smoothstep(0.01, 0.02, diff) * 2.0) / 2.0;
}

float neighborNormalEdgeIndicator(vec2 uv, int x, int y, float depth, vec3 normal)
{
	float depthDiff = getDepth(uv, x, y) - depth;
	vec3 neighborNormal = getNormal(uv, x, y);

	// Edge pixels should yield to faces whose normals are closer to the bias normal.
	vec3 normalEdgeBias = vec3(1.0, 1.0, 1.0);
	float normalDiff = dot(normal - neighborNormal, normalEdgeBias);
	float normalIndicator = clamp(smoothstep(-0.01, 0.01, normalDiff), 0.0, 1.0);

	// Only the shallower pixel should detect the normal edge.
	float depthIndicator = clamp(sign(depthDiff * 0.25 + 0.0025), 0.0, 1.0);

	return (1.0 - dot(normal, neighborNormal)) * depthIndicator * normalIndicator;
}

float normalEdgeIndicator(vec2 uv, float depth, vec3 normal)
{
	float indicator = 0.0;
	indicator += neighborNormalEdgeIndicator(uv, 0, -1, depth, normal);
	indicator += neighborNormalEdgeIndicator(uv, 0, 1, depth, normal);
	indicator += neighborNormalEdgeIndicator(uv, -1, 0, depth, normal);
	indicator += neighborNormalEdgeIndicator(uv, 1, 0, depth, normal);
	return step(0.1, indicator);
}

vec4 shader(vec4 color, ShaderParams params)
{
	vec2 uv = params.screen_uv;

	if (u_view_mode > 1.5) {
		return vec4(vec3(getDepth(uv, 0, 0)), 1.0);
	}
	if (u_view_mode > 0.5) {
		return vec4(getNormal(uv, 0, 0) * 0.5 + 0.5, 1.0);
	}

	vec4 texel = texture(scene_tex, uv);
	float depth = getDepth(uv, 0, 0);
	vec3 normal = getNormal(uv, 0, 0);

	float dei = u_depth_edge_strength > 0.0 ? depthEdgeIndicator(uv, depth) : 0.0;
	float nei = u_normal_edge_strength > 0.0 ? normalEdgeIndicator(uv, depth, normal) : 0.0;

	// Depth edges darken, normal edges brighten, and depth wins where both fire.
	float strength = dei > 0.0
		? (1.0 - u_depth_edge_strength * dei)
		: (1.0 + u_normal_edge_strength * nei);

	return vec4(texel.rgb * strength, texel.a);
}
