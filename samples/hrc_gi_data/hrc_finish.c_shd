// HRC finish: per-display-pixel reconstruction (merge_0 + a level-0 trace),
// unified 2-group model. Dispatched once per global rotation u_rot with that
// rotation's GROUP R_0 buffer (4 segments: local rot 0 -> segs 0,1; local rot 1
// -> segs 2,3). u_local_rot in {0,1} says which the group u_rot is.
// Scatter: dispatch cell (cascade x cross world dims) -> screen out_cell.
//
// DISPLAY-RES GATHER (u_scale > 1): the dispatch runs over FULL display
// resolution even when the cascade runs reduced. Each display pixel keeps the
// probe machinery of its HRC cell (mcell/parity/segment) but traces its OWN c-1
// interval from its true position through the full-res scene. The last interval
// is what carries hard shadow edges, so shadows resolve at display resolution
// while everything above level 0 stays cheap -- Sannikov's recipe for making a
// low-res cascade look native. This replaces the old minmax-gated bilinear
// upscale in hrc_display: interpolation now happens THROUGH the scene (the
// trace's transmittance handles occlusion) instead of across probe texels.
// At u_scale == 1 every expression reduces to the original path, bit for bit.
//
// Group R_0 layout: idx = (x*2 + cone)*(4*cross_grid) + yy,  yy in [0, 4*cross_grid)
// (yy innermost, matching the cascade buffers).

layout(set = 0, binding = 0) uniform sampler2D u_emission;
layout(set = 0, binding = 1) uniform sampler2D u_opacity;
layout(std430, set = 0, binding = 2) readonly buffer R0Rad { uvec2 data[]; } u_r0_rad;
layout(set = 1, binding = 0, rgba16f) uniform image2D u_a0; // sum over all cones (= scalar fluence)
layout(set = 1, binding = 1, rgba16f) uniform image2D u_a1; // sum L*cos(theta)
layout(set = 1, binding = 2, rgba16f) uniform image2D u_b1; // sum L*sin(theta)

layout(set = 2, binding = 0) uniform Params
{
	int u_grid_w;
	int u_grid_h;
	int u_world_w;
	int u_world_h;
	int u_rot;        // global rotation 0..3
	int u_local_rot;  // 0 or 1: which rotation of its group u_rot is
	int u_scale;      // HRC space -> full-res scene ratio
	int u_full_w;     // full-res scene width
	int u_full_h;     // full-res scene height
	float u_abs_zoom; // absorption units-per-pixel factor (see hrc_trace)
};

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

const float PI = 3.14159265359;
const float TAU = 6.28318530718;
vec4 f16_load(uvec2 p) { return vec4(unpackHalf2x16(p.x), unpackHalf2x16(p.y)); }

vec2 seg_rotation(int rot)
{
	if (rot == 1) return vec2(0.0, 1.0);
	if (rot == 2) return vec2(-1.0, 0.0);
	if (rot == 3) return vec2(0.0, -1.0);
	return vec2(1.0, 0.0);
}
float world_along(vec2 dir) { return (abs(dir.x) > 0.5) ? float(u_world_w) : float(u_world_h); }
float full_along(vec2 dir)  { return (abs(dir.x) > 0.5) ? float(u_full_w) : float(u_full_h); }
int   grid_along(vec2 dir)  { return (abs(dir.x) > 0.5) ? u_grid_w : u_grid_h; }

vec2 XDIR() { return seg_rotation(u_rot); }
vec2 YDIR() { vec2 x = XDIR(); return vec2(-x.y, x.x); }
int  CASC() { return grid_along(XDIR()); }
int  CROSS(){ return grid_along(YDIR()); }

vec2 seg_origin(int y_offset)
{
	vec2 x_dir = XDIR(); vec2 y_dir = YDIR();
	vec2 corner = vec2(float(u_world_w) * 0.5 * (1.0 - (x_dir.x + y_dir.x)),
	                   float(u_world_h) * 0.5 * (1.0 - (x_dir.y + y_dir.y)));
	return corner + y_dir * (float(y_offset) + 0.499) + x_dir * 0.501;
}
// level-0 cell -> screen (size_x = casc_grid, cross = cross_grid).
vec2 to_world0(vec2 cell_local, int y_offset)
{
	vec2 x_dir = XDIR(); vec2 y_dir = YDIR();
	float pn_c = cell_local.x / float(CASC());
	float pn_x = cell_local.y / float(CROSS());
	return pn_c * world_along(x_dir) * x_dir + pn_x * world_along(y_dir) * y_dir + seg_origin(y_offset);
}

// start/end arrive in HRC space; march in FULL-RES scene space so occlusion
// stays sharp at reduced probe resolution.
void trace_to(vec2 start, vec2 end, out vec3 rad, out vec3 trn)
{
	rad = vec3(0.0); trn = vec3(1.0);
	float sc = float(u_scale);
	start *= sc; end *= sc;
	vec2 d = end - start; float len = length(d);
	if (len < 1e-5) return;
	vec2 ray_dir = d / len;
	vec2 inv_dir = 1.0 / (ray_dir + vec2(1e-30));
	vec2 szf = vec2(float(u_full_w), float(u_full_h));
	vec2 lo = (vec2(0.1) - start) * inv_dir;
	vec2 hi = (szf - vec2(0.1) - start) * inv_dir;
	vec2 tmn = min(lo, hi), tmx = max(lo, hi);
	float start_t = max(max(tmn.x, tmn.y), 0.0);
	float end_t = min(min(tmx.x, tmx.y), len) - start_t;
	if (end_t <= 0.01) return;
	vec2 ray_start = start + start_t * ray_dir;
	ivec2 pos = ivec2(floor(ray_start));
	vec2 delta = abs(inv_dir);
	vec2 sgn = sign(ray_dir);
	ivec2 rstep = ivec2(sgn);
	vec2 side = (sgn * (vec2(pos) - ray_start) + sgn * 0.5 + 0.5) * delta;
	float last_t = 0.0;
	for (int it = 0; it < 3000; it++) {
		float next_t = min(side.x, side.y);
		ivec2 fp = ivec2(pos);
		vec3 emis = texelFetch(u_emission, fp, 0).rgb;
		vec3 opac = texelFetch(u_opacity, fp, 0).rgb * u_abs_zoom;
		float seg = min(next_t, end_t) - last_t;
		vec3 tr = exp(-opac * seg);
		rad += trn * emis * (vec3(1.0) - tr);
		trn *= tr;
		last_t = next_t;
		if (next_t >= end_t) break;
		float mx = (side.x <= side.y) ? 1.0 : 0.0;
		float my = (side.y <= side.x) ? 1.0 : 0.0;
		side += vec2(mx, my) * delta;
		pos  += ivec2(int(mx), int(my)) * rstep;
	}
}

// group R_0 load. cone in [0,2), yy in [0, 4*cross_grid), x in [0, casc_grid).
vec3 R0(int x, int yy, int cone)
{
	int cg = CROSS(), cx = CASC();
	if (x < 0 || x >= cx || cone < 0 || cone >= 2 || yy < 0 || yy >= 4 * cg) return vec3(0.0);
	int idx = (x * 2 + cone) * (4 * cg) + yy;
	return f16_load(u_r0_rad.data[idx]).rgb;
}
bool contains0(int yy, int local_seg) { int ly = yy - CROSS() * local_seg; return ly >= 0 && ly < CROSS(); }

// qpos: the querying display pixel's own position in HRC world units. Only used
// at u_scale > 1; at scale 1 the original probe-space derivation is kept so the
// output stays bit-exact with the validated reference port.
void trace_0(ivec2 cell, int local_seg, bool parity, vec2 qpos, out vec3 lo_rad, out vec3 lo_trn, out vec3 hi_rad, out vec3 hi_trn)
{
	int yoff = local_seg & 1;
	vec2 cell_f = vec2(cell) + (parity ? vec2(0.0) : vec2(0.5, 0.5));
	int seg_off = CROSS() * local_seg;
	vec2 start = (u_scale > 1) ? qpos
	           : to_world0(vec2(cell_f.x, cell_f.y - float(seg_off)) - vec2(0.49, 0.0), yoff);
	float factor = parity ? 2.0 : 1.0;
	ivec2 lo = ivec2(cell_f + vec2(0.5, -0.5) * factor);
	ivec2 hi = ivec2(cell_f + vec2(0.5,  0.5) * factor);
	vec2 lo_w = to_world0(vec2(float(lo.x), float(lo.y - seg_off)), yoff);
	vec2 hi_w = to_world0(vec2(float(hi.x), float(hi.y - seg_off)), yoff);
	trace_to(start, lo_w, lo_rad, lo_trn);
	trace_to(start, hi_w, hi_rad, hi_trn);
	if (!contains0(lo.y, local_seg)) { lo_trn = vec3(0.0); }
	if (!contains0(hi.y, local_seg)) { hi_trn = vec3(0.0); }
	lo_rad *= (PI / 4.0) / TAU;
	hi_rad *= (PI / 4.0) / TAU;
}

// Returns the LOWER and UPPER cone contributions separately. Summing them gives
// the old scalar result exactly; keeping them apart is what makes the output
// directional (4 rotations x 2 cones = 8 angular bins over 2*pi).
void merge_0(ivec2 cell, int local_seg, bool parity, vec2 qpos, out vec3 cone_lo, out vec3 cone_hi)
{
	int lo_dy = parity ? -1 : 0;
	vec3 lr, lt, hr, ht;
	trace_0(cell, local_seg, parity, qpos, lr, lt, hr, ht);
	vec3 next_lower = lr + lt * R0(cell.x + 1, cell.y + lo_dy, 0);
	vec3 next_upper = hr + ht * R0(cell.x + 1, cell.y + 1,     1);
	if (parity) {
		cone_lo = 0.5 * (R0(cell.x, cell.y, 0) + next_lower);
		cone_hi = 0.5 * (R0(cell.x, cell.y, 1) + next_upper);
	} else {
		cone_lo = next_lower;
		cone_hi = next_upper;
	}
}

void main()
{
	// dispatch cell in the rotated frame at FULL display res: x spans the cascade
	// world axis, y the cross axis. At scale 1 cellF == the HRC cell.
	ivec2 cellF = ivec2(gl_GlobalInvocationID.xy);
	if (float(cellF.x) >= full_along(XDIR()) || float(cellF.y) >= full_along(YDIR())) return;
	ivec2 cell = cellF / u_scale;   // HRC-space cell: drives all probe machinery
	float world_c = world_along(XDIR());

	// out_cell: the display pixel this thread writes, in full-res screen space.
	vec2 x_dir = XDIR(); vec2 y_dir = YDIR();
	vec2 corner = vec2(float(u_full_w) * 0.5 * (1.0 - (x_dir.x + y_dir.x)),
	                   float(u_full_h) * 0.5 * (1.0 - (x_dir.y + y_dir.y)));
	vec2 origin_f = corner + (x_dir + y_dir) * 0.5;
	vec2 value = floor(origin_f + x_dir * float(cellF.x) + y_dir * float(cellF.y));
	if (value.x < 0.0 || value.y < 0.0 || value.x >= float(u_full_w) || value.y >= float(u_full_h)) return;
	ivec2 out_cell = ivec2(value);

	int fcx = cell.x + 1;
	if (float(fcx) >= world_c) return;
	int fcy = cell.y;
	int cxp = fcx % 2;
	int cyp = fcy % 2;
	int cg = CROSS();
	int global_y = 2 * cg * u_local_rot;
	int off;
	if (cxp == cyp)      off = 0;
	else if (cyp == 0)   off = cg - 1;
	else                 off = cg;
	int local_seg = 2 * u_local_rot + ((cxp != cyp) ? 1 : 0);
	bool parity = (cxp == 0);
	ivec2 mcell = ivec2(fcx / 2, (fcy / 2) + off + global_y);
	// The querying pixel's own centre in HRC world units: this is where the c-1
	// interval starts at u_scale > 1, giving display-res occlusion in the last hop.
	vec2 qpos = (vec2(out_cell) + 0.5) / float(u_scale);
	vec3 cone_lo, cone_hi;
	merge_0(mcell, local_seg, parity, qpos, cone_lo, cone_hi);

	// Project the two cones onto a 2D Fourier L1 basis and accumulate over the 4
	// rotations. Cone centres sit at +-22.5 deg either side of this rotation's
	// cascade axis, so the 8 cones tile 2*pi at 45 deg spacing.
	//   a0 = sum L                (= the old scalar fluence, unchanged)
	//   a1 = sum L*cos(theta),  b1 = sum L*sin(theta)
	// Reconstruct later as L(t) ~ a0/(2pi) + (a1*cos t + b1*sin t)/pi.
	float base = atan(x_dir.y, x_dir.x);
	const float Q = 0.39269908; // pi/8 = 22.5 deg
	float t_lo = base - Q, t_hi = base + Q;

	vec3 a0 = cone_lo + cone_hi;
	vec3 a1 = cone_lo * cos(t_lo) + cone_hi * cos(t_hi);
	vec3 b1 = cone_lo * sin(t_lo) + cone_hi * sin(t_hi);

	if (u_rot != 0) {
		a0 += imageLoad(u_a0, out_cell).rgb;
		a1 += imageLoad(u_a1, out_cell).rgb;
		b1 += imageLoad(u_b1, out_cell).rgb;
	}
	imageStore(u_a0, out_cell, vec4(a0, 1.0));
	imageStore(u_a1, out_cell, vec4(a1, 1.0));
	imageStore(u_b1, out_cell, vec4(b1, 1.0));
}
