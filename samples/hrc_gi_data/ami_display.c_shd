// Display/composite for the exact HRC path: sum the 4 per-rotation radiance
// textures, add rim light on rock surfaces, write linear fluence (feedback) and
// the AgX-tonemapped display image.
//
// No grid->world upscale here: ami_ns_finish scatters at WORLD resolution, so
// radiance is already per-pixel (unlike the dual-lattice path whose R_0 lives at
// grid resolution and needed minmax-gated bilinear interpolation).

// Directional radiance as 2D Fourier L1: L(t) ~ a0/(2pi) + (a1*cos t + b1*sin t)/pi
layout(set = 0, binding = 0) uniform sampler2D u_a0;   // sum over cones (scalar fluence)
layout(set = 0, binding = 1) uniform sampler2D u_a1;   // sum L*cos(theta)
layout(set = 0, binding = 2) uniform sampler2D u_b1;   // sum L*sin(theta)
layout(set = 0, binding = 3) uniform sampler2D u_unused;
layout(set = 0, binding = 4) uniform sampler2D u_absorption;
layout(set = 0, binding = 5) uniform sampler2D u_minmax; // prefiltered box min/max per HRC cell
layout(set = 1, binding = 0, rgba8)   uniform image2D u_fluence;      // display (rgba8)
layout(set = 1, binding = 1, rgba16f) uniform image2D u_fluence_lin;  // linear (feedback)

layout(set = 2, binding = 0) uniform Params
{
	int   u_world_w;       // full-res output width
	int   u_world_h;       // full-res output height
	float u_exposure;      // per-scene display scale (raw AgX otherwise)
	int   u_rim;           // rim light on/off
	float u_rim_strength;
	float u_rock_thresh;
	int   u_scale;         // HRC space -> full-res ratio (1 = no upscale)
	int   u_hrc_w;         // HRC radiance width  = world_w / scale
	int   u_hrc_h;         // HRC radiance height = world_h / scale
	float u_abs_threshold; // minmax gate: absorption range that forces nearest
};

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

vec3 agx_contrast(vec3 x)
{
	vec3 x2 = x * x;
	vec3 x4 = x2 * x2;
	return 15.5 * x4 * x2 - 40.14 * x4 * x + 31.96 * x4 - 6.868 * x2 * x
	     + 0.4298 * x2 + 0.1191 * x - 0.00232;
}
vec3 agx_tonemap(vec3 v)
{
	const mat3 agx_in = mat3(
		0.842479062253094, 0.0423282422610123, 0.0423756549057051,
		0.0784335999999992, 0.878468636469772,  0.0784336,
		0.0792237451477643, 0.0791661274605434, 0.879142973793104);
	const mat3 agx_out = mat3(
		 1.19687900512017,   -0.0528968517574562, -0.0529716355144438,
		-0.0980208811401368,  1.15190312990417,   -0.0980434501171241,
		-0.0990297440797205, -0.0989611768448433,  1.15107367264116);
	const float min_ev = -12.47393;
	const float max_ev = 4.026069;
	v = agx_in * v;
	v = clamp(log2(v), min_ev, max_ev);
	v = (v - min_ev) / (max_ev - min_ev);
	v = agx_contrast(v);
	v = agx_out * v;
	return clamp(v, 0.0, 1.0);
}

ivec2 clamp_pos(ivec2 p) { return clamp(p, ivec2(0), ivec2(u_world_w - 1, u_world_h - 1)); }
float absorption_at(ivec2 p) { return texelFetch(u_absorption, clamp_pos(p), 0).r; }
// 1.0 where the world pixel is solid rock (high absorption), else 0.0.
float rock_mask(ivec2 p) { return absorption_at(p) > u_rock_thresh ? 1.0 : 0.0; }

// Raw fetch from a per-rotation radiance texture (HRC-space coords).
vec3 rad_texel(int band, ivec2 p)
{
	p = clamp(p, ivec2(0), ivec2(u_hrc_w - 1, u_hrc_h - 1));
	if (band == 0) return texelFetch(u_a0, p, 0).rgb;
	if (band == 1) return texelFetch(u_a1, p, 0).rgb;
	return texelFetch(u_b1, p, 0).rgb;
}

// Box min/max of absorption over the full-res footprint of one HRC cell. A cell
// straddling an occluder edge has a large range -> we must not interpolate across
// it, or light bleeds through walls. This is the HRC-appropriate prefilter: the
// gate is on the OCCLUDER field, which is what makes interpolation invalid, not
// on the radiance itself.
vec2 cell_minmax(ivec2 c)
{
	c = clamp(c, ivec2(0), ivec2(u_hrc_w - 1, u_hrc_h - 1));
	return texelFetch(u_minmax, c, 0).rg; // precomputed by ami_minmax
}

// Sample radiance at a FULL-RES pixel, upscaling from HRC space with a
// minmax-gated bilinear: smooth where the occluder field is uniform, snapping to
// nearest across occluder boundaries.
vec3 rad_at(int rot, ivec2 p)
{
	p = clamp_pos(p);
	if (u_scale == 1) return rad_texel(rot, p);

	vec2 f = (vec2(p) + 0.5) / float(u_scale) - 0.5;
	ivec2 g0 = ivec2(floor(f));
	vec2 t = fract(f);

	float range = 0.0;
	for (int dy = 0; dy <= 1; dy++)
		for (int dx = 0; dx <= 1; dx++) {
			vec2 mm = cell_minmax(g0 + ivec2(dx, dy));
			range = max(range, mm.y - mm.x);
		}
	float blend = 1.0 - smoothstep(0.0, u_abs_threshold, range); // 1 = bilinear, 0 = nearest

	vec3 c00 = rad_texel(rot, g0);
	vec3 c10 = rad_texel(rot, g0 + ivec2(1, 0));
	vec3 c01 = rad_texel(rot, g0 + ivec2(0, 1));
	vec3 c11 = rad_texel(rot, g0 + ivec2(1, 1));
	vec3 bil = mix(mix(c00, c10, t.x), mix(c01, c11, t.x), t.y);
	vec3 nearest = rad_texel(rot, ivec2(round(f)));
	return mix(nearest, bil, blend);
}

// Rim light for rock pixels near the surface: outward normal from the rock
// occupancy gradient, directional fluence sampled just outside the surface,
// weighted by how much the surface faces each arrival direction.
vec3 rim_light(ivec2 pos)
{
	int R = 3;
	float mxp = rock_mask(pos + ivec2( R,  0));
	float mxn = rock_mask(pos + ivec2(-R,  0));
	float myp = rock_mask(pos + ivec2( 0,  R));
	float myn = rock_mask(pos + ivec2( 0, -R));
	float mpp = rock_mask(pos + ivec2( R,  R));
	float mpn = rock_mask(pos + ivec2( R, -R));
	float mnp = rock_mask(pos + ivec2(-R,  R));
	float mnn = rock_mask(pos + ivec2(-R, -R));

	vec2 grad = vec2(
		(mxp - mxn) + 0.5 * ((mpp + mpn) - (mnp + mnn)),
		(myp - myn) + 0.5 * ((mpp + mnp) - (mpn + mnn))
	);
	float glen = length(grad);
	if (glen < 0.25) return vec3(0.0); // deep interior or fully surrounded
	vec2 n = -grad / glen; // outward: away from increasing rock occupancy

	ivec2 p_out = clamp_pos(pos + ivec2(int(round(n.x * 4.0)), int(round(n.y * 4.0))));
	if (rock_mask(p_out) > 0.5) return vec3(0.0);

	// Cosine-weighted hemisphere integral of L(t) about normal n, in closed form:
	//   E(n) = a0/pi + (a1*n.x + b1*n.y)/2
	// (DC term integrates to 2 over the hemisphere; the L1 terms to (pi/2)*cos.)
	vec3 A0 = rad_at(0, p_out), A1 = rad_at(1, p_out), B1 = rad_at(2, p_out);
	vec3 E = A0 * (1.0 / 3.14159265) + (A1 * n.x + B1 * n.y) * 0.5;
	return max(E, vec3(0.0)) * u_rim_strength;
}

void main()
{
	ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
	if (gid.x >= u_world_w || gid.y >= u_world_h) return;

	vec3 lin = rad_at(0, gid); // a0 == the old 4-rotation sum, bit for bit

	if (u_rim != 0 && absorption_at(gid) > u_rock_thresh) {
		lin += rim_light(gid);
	}

	imageStore(u_fluence_lin, gid, vec4(lin, 1.0));
	vec3 disp = agx_tonemap(lin * u_exposure);
	imageStore(u_fluence, gid, vec4(disp, 1.0));
}
